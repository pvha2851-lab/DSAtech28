#include<bits/stdc++.h>
using namespace std;
vector<int> adj[1005];
vector<pair<int,int>> edge;
bool visited[1005];
int n,m,s,t;
void DFS(int u){
	visited[u]=true;
	for(int v:adj[u]){
		if((u==s&&v==t)||(u==t&&v==s))	continue;
		if(!visited[v]){
			DFS(v);
		}
	}
}
int tplt(){
	int dem=0;
	for(int i=1;i<=n;i++){
		if(!visited[i]){
			dem++;
			DFS(i);
		}
	}
	return dem;
}
int canh_cau(){
	int cc=tplt();
	int res=0;
	for(pair<int,int> e:edge){
		s=e.first,t=e.second;
		memset(visited,false,sizeof(visited));
		if(cc<tplt())	res++;
	}
	return res;
}
void nhap(){
	cin>>n>>m;
	for(int i=0;i<m;i++){
		int x,y;
		cin>>x>>y;
		adj[x].push_back(y);
		adj[y].push_back(x);
		edge.push_back({x,y});
	}
	sort(edge.begin(),edge.end());
	for(int i=1;i<=n;i++){
		sort(adj[i].begin(),adj[i].end());
	}
	memset(visited,false,sizeof(visited));
	cout<<canh_cau();
}
int main(){
	nhap();
	return 0;
}
