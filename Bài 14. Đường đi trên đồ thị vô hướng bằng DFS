#include<bits/stdc++.h>
using namespace std;
vector<int> adj[1005];
bool visited[1005];
int n,m,s,t;
int parent[1005];
void DFS(int u){
	visited[u]=true;
	for(int v:adj[u]){
		if(!visited[v]){
			parent[v]=u;
			DFS(v);
		}
	}
}
void path(){
	if(!visited[t])	cout<<-1;
	else{
		vector<int> res;
		while(t!=s){
			res.push_back(t);
			t=parent[t];
		}
		res.push_back(s);
		reverse(res.begin(),res.end());
		for(int x:res)	cout<<x<<" ";
	}
}
void nhap(){
	cin>>n>>m>>s>>t;
	for(int i=0;i<m;i++){
		int x,y;
		cin>>x>>y;
		adj[x].push_back(y);
		adj[y].push_back(x);
	}
	for(int i=1;i<=n;i++){
		sort(adj[i].begin(),adj[i].end());
	}
	memset(visited,false,sizeof(visited));
	memset(parent,0,sizeof(parent));
	DFS(s);
	path();
}
int main(){
	nhap();
	return 0;
}
