#include<bits/stdc++.h>
using namespace std;
struct node{
	int data;
	node *left;
	node *right;
};
node* makeNode(int x){
	node *newNode=new node;
	newNode->data=x;
	newNode->left=NULL;
	newNode->right=NULL;
	return newNode;
}
node* findNode(node *root,int x){
	if(root==NULL)	return NULL;
	if(root->data==x)	return root;
	node *left=findNode(root->left,x);
	if(left!=NULL)	return left;
	return findNode(root->right,x);
}
bool isFull(node *root){
	if(root==NULL)	return true;
	//node la
	if(root->left==NULL&&root->right==NULL)	return true;
	//node trung gian du 2 con
	if(root->left!=NULL&root->right!=NULL)	return isFull(root->left)&&isFull(root->right);
	//chi co 1 node con
	return false;
}
int main(){
	int N;cin>>N;
	cin.ignore();
	set<int> child,parent;
	node *root=NULL;
	for(int i=0;i<N;i++){
		int x,y;char z;
		cin>>x>>y>>z;
		parent.insert(x);
		child.insert(y);
		if(root==NULL)	root=makeNode(x);
		node *cha=findNode(root,x);
		if(cha==NULL)	cha=makeNode(x);
		node *con=makeNode(y);
		if(z=='L')	cha->left=con;
		else if(z=='R')	cha->right=con;
	}
	int rootVal;
	for(int x:parent){
		if(child.count(x)==0){
			rootVal=x;
			break;
		}
	}
	root=findNode(root,rootVal);
	if(isFull(root))	cout<<"YES";
	else cout<<"NO";
	return 0;
}
