#include<bits/stdc++.h>
using namespace std;
struct node{
	int data;
	node *left;
	node *right;
};
node* makeNode(int x){
	node *newNode=new node;
	newNode->data=x;
	newNode->left=NULL;
	newNode->right=NULL;
	return newNode;
}
node *findNode(node *root,int x){
	if(root==NULL)	return NULL;
	if(root->data==x)	return root;
	node *left=findNode(root->left,x);
	if(left!=NULL)	return left;
	return findNode(root->right,x);
}
void postorder(node *root){
	if(root!=NULL){
		postorder(root->left);
		postorder(root->right);
		cout<<root->data<<" ";
	}
}
int main(){
	int N;
	cin>>N;cin.ignore();
	node *root=NULL;
	set<int> child,parent;
	for(int i=0;i<N;i++){
		int x,y;char z;
		cin>>x>>y>>z;
		parent.insert(x);
		child.insert(y);
		if(root==NULL)	root=makeNode(x);
		node *cha=findNode(root,x);
		if(cha==NULL)	cha=makeNode(x);
		node *con=makeNode(y);
		if(z=='L')	cha->left=con;
		else if(z=='R')	cha->right=con;
	}
	int rootVal;
	for(int x:parent){
		if(child.count(x)==0){
			rootVal=x;
			break;
		}
	}
	root=findNode(root,rootVal);
	postorder(root);
	return 0;
}
