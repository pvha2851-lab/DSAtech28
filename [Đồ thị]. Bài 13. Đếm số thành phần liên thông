#include<bits/stdc++.h>
using namespace std;
vector<int> adj[1005];
int n,m;
bool visited[1005];
void DFS(int u){
	visited[u]=true;
	for(int v:adj[u]){
		if(!visited[v]){
			DFS(v);
		}
	}
}
int tplt(){
	int dem=0;
	for(int i=1;i<=n;i++){
		if(!visited[i]){
			DFS(i);
			dem++;
		}
	}
	return dem;
}
void nhap(){
	cin>>n>>m;
	for(int i=0;i<m;i++){
		int x,y;
		cin>>x>>y;
		adj[x].push_back(y);
		adj[y].push_back(x);
	}
	for(int i=1;i<=n;i++){
		sort(adj[i].begin(),adj[i].end());
	}
	memset(visited,false,sizeof(visited));
	cout<<tplt();
}
int main(){
	nhap();
	return 0;
}
