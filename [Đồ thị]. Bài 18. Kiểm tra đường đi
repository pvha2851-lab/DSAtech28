#include<bits/stdc++.h>
using namespace std;
vector<int> adj[1005];
int n,m;
bool visited[1005];
int parent[1005];
int lt[1005];
int dem=0;
void DFS(int u){
	visited[u]=true;
	lt[u]=dem;
	for(int v:adj[u]){
		if(!visited[v]){
			parent[v]=u;
			DFS(v);
		}
	}
}
void tplt(){
	for(int i=1;i<=n;i++){
		if(!visited[i]){
			dem++;
			DFS(i);
		}
	}
}
void nhap(){
	cin>>n>>m;
	for(int i=0;i<m;i++){
		int x,y;
		cin>>x>>y;
		adj[x].push_back(y);
		adj[y].push_back(x);
	}
	for(int i=1;i<=n;i++){
		sort(adj[i].begin(),adj[i].end());
	}
	memset(visited,false,sizeof(visited));
	memset(parent,0,sizeof(parent));
	tplt();
}
int main(){
	nhap();
	int k;
	cin>>k;
	while(k--){
		int s,t;
		cin>>s>>t;
		if(lt[s]==lt[t])	cout<<1<<endl;
		else cout<<-1<<endl;
	}
	return 0;
}
