#include<bits/stdc++.h>
using namespace std;
vector<int> adj[1005];
int n,m,s;
bool visited[1005];
void DFS(int u){
	visited[u]=true;
	cout<<u<<" ";
	for(int v:adj[u]){
		if(!visited[v]){
			DFS(v);
		}
	}
}
void nhap(){
	cin>>n>>m>>s;
	for(int i=0;i<m;i++){
		int x,y;
		cin>>x>>y;
		adj[x].push_back(y);
	}
	for(int i=1;i<=n;i++){
		sort(adj[i].begin(),adj[i].end());
	}
	DFS(s);
}
int main(){
	nhap();
	return 0;
}
